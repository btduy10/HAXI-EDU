# Sao chép thành .env rồi chỉnh giá trị. KHÔNG commit file .env.

# PostgreSQL (docker compose)
POSTGRES_USER=haxi
POSTGRES_PASSWORD=haxi_dev_password
POSTGRES_DB=haxi_edu
POSTGRES_PORT=5432
DATABASE_URL=postgres://haxi:haxi_dev_password@localhost:5432/haxi_edu
TEST_DATABASE_URL=postgres://haxi:haxi_dev_password@localhost:5432/haxi_edu_test

# Better Auth — tạo bí mật bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000

# Khóa tài khoản khi đăng nhập sai
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Mật khẩu tạm cho tài khoản demo khi chạy seed (bắt buộc đổi ở lần đăng nhập đầu)
SEED_DEFAULT_PASSWORD=Haxi@2026

# Production luôn ép HTTPS (chuyển hướng, HSTS, cookie Secure). Chỉ đặt false khi thử `npm run build && npm start` trên máy qua HTTP.
# FORCE_HTTPS=false

